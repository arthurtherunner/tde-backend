@baseUrl = http://127.0.0.1:8000/api

### 1. Login admin
# @name loginAdmin
POST {{baseUrl}}/login
Content-Type: application/json

{"email": "admin@unifan.com", "senha": "12345678"}

###
@token = {{loginAdmin.response.body.access_token}}

### 2. Login autor
# @name loginAutor
POST {{baseUrl}}/login
Content-Type: application/json

{"email": "autor@unifan.com", "senha": "12345678"}

###
@tokenAutor = {{loginAutor.response.body.access_token}}

### 3. Criar curso (esperado 201)
POST {{baseUrl}}/cursos
Authorization: Bearer {{token}}
Content-Type: application/json

{"nome": "Análise e Desenvolvimento de Sistemas", "descricao": "ADS", "formato": "presencial"}

### 4. Listar cursos (esperado 200)
GET {{baseUrl}}/cursos
Authorization: Bearer {{token}}

### 5. Criar disciplina (esperado 201)
POST {{baseUrl}}/disciplinas
Authorization: Bearer {{token}}
Content-Type: application/json

{"nome": "Programação Backend", "descricao": "API", "carga_horaria": 80, "turno": "noturno", "curso_id": 1}

### 6. Disciplinas do curso 1 (esperado 200)
GET {{baseUrl}}/cursos/1/disciplinas
Authorization: Bearer {{token}}

### 7. Remover curso com disciplina (esperado 409)
DELETE {{baseUrl}}/cursos/1
Authorization: Bearer {{token}}

### 8. Associar autor ao curso 1 (esperado 200)
PUT {{baseUrl}}/users/2/cursos
Authorization: Bearer {{token}}
Content-Type: application/json

{"cursos": [1]}

### 9. Associar autor à disciplina 1 (esperado 200)
PUT {{baseUrl}}/users/2/disciplinas
Authorization: Bearer {{token}}
Content-Type: application/json

{"disciplinas": [1]}

### 10. Listar disciplinas do autor (esperado 200)
GET {{baseUrl}}/users/2/disciplinas
Authorization: Bearer {{token}}

### 11. Remover disciplina com usuário associado (esperado 409)
DELETE {{baseUrl}}/disciplinas/1
Authorization: Bearer {{token}}

### 12. Autor tentando criar curso (esperado 403)
POST {{baseUrl}}/cursos
Authorization: Bearer {{tokenAutor}}
Content-Type: application/json

{"nome": "Teste", "descricao": "x", "formato": "ead"}

### 13. Autor cria questão de múltipla escolha (esperado 201)
POST {{baseUrl}}/questoes
Authorization: Bearer {{tokenAutor}}
Content-Type: application/json

{
  "tipo": "multipla_escolha",
  "nivel_dificuldade": "facil",
  "descricao": "Qual verbo HTTP é usado para criar um recurso?",
  "disciplina_id": 1,
  "quantidade_opcoes": 4,
  "opcoes": [
    {"texto_opcao": "GET", "correta": false},
    {"texto_opcao": "POST", "correta": true},
    {"texto_opcao": "DELETE", "correta": false},
    {"texto_opcao": "PATCH", "correta": false}
  ]
}

### 14. Autor cria questão aberta (esperado 201)
POST {{baseUrl}}/questoes
Authorization: Bearer {{tokenAutor}}
Content-Type: application/json

{"tipo": "aberta", "nivel_dificuldade": "media", "descricao": "Explique o que é uma API REST.", "disciplina_id": 1}

### 15. Admin tentando criar questão (esperado 403)
POST {{baseUrl}}/questoes
Authorization: Bearer {{token}}
Content-Type: application/json

{"tipo": "aberta", "nivel_dificuldade": "facil", "descricao": "Teste", "disciplina_id": 1}

### 16. Quantidade de opções diferente das enviadas (esperado 422)
POST {{baseUrl}}/questoes
Authorization: Bearer {{tokenAutor}}
Content-Type: application/json

{
  "tipo": "multipla_escolha",
  "nivel_dificuldade": "dificil",
  "descricao": "Teste de validação",
  "disciplina_id": 1,
  "quantidade_opcoes": 3,
  "opcoes": [
    {"texto_opcao": "A", "correta": true},
    {"texto_opcao": "B", "correta": false}
  ]
}

### 17. Listar questões da disciplina 1 como autor (esperado 200)
GET {{baseUrl}}/disciplinas/1/questoes
Authorization: Bearer {{tokenAutor}}

### 18. Autor cria avaliação (esperado 201)
# @name criarAvaliacao
POST {{baseUrl}}/avaliacoes
Authorization: Bearer {{tokenAutor}}
Content-Type: application/json

{
  "curso_id": 1,
  "disciplina_id": 1,
  "semestre": "2026.2",
  "data_avaliacao": "2026-12-10",
  "tipo": "AV2",
  "valor": 10,
  "quantidade_questoes_multipla": 1,
  "quantidade_questoes_abertas": 1
}

###
@avaliacaoId = {{criarAvaliacao.response.body.id}}

### 19. Admin tentando criar avaliação (esperado 403)
POST {{baseUrl}}/avaliacoes
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "curso_id": 1,
  "disciplina_id": 1,
  "semestre": "2026.2",
  "data_avaliacao": "2026-12-10",
  "tipo": "AV2",
  "valor": 10,
  "quantidade_questoes_multipla": 1,
  "quantidade_questoes_abertas": 1
}

### 20. Tipo de avaliação inválido (esperado 422)
POST {{baseUrl}}/avaliacoes
Authorization: Bearer {{tokenAutor}}
Content-Type: application/json

{
  "curso_id": 1,
  "disciplina_id": 1,
  "semestre": "2026.2",
  "data_avaliacao": "2026-12-10",
  "tipo": "AV9",
  "valor": 10,
  "quantidade_questoes_multipla": 1,
  "quantidade_questoes_abertas": 1
}

### 21. Autor edita a própria avaliação (esperado 200)
PUT {{baseUrl}}/avaliacoes/{{avaliacaoId}}
Authorization: Bearer {{tokenAutor}}
Content-Type: application/json

{"semestre": "2026.2", "valor": 8}

### 22. Admin edita a avaliação do autor (esperado 200)
PUT {{baseUrl}}/avaliacoes/{{avaliacaoId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{"valor": 10}

### 23. Admin cria o autor 2 (esperado 201, ou 422 se já existir)
POST {{baseUrl}}/users
Authorization: Bearer {{token}}
Content-Type: application/json

{"nome": "Autor Dois", "email": "autor2@unifan.com", "tipo": "autor", "senha": "12345678"}

### 24. Login autor 2 (esperado 200)
# @name loginAutor2
POST {{baseUrl}}/login
Content-Type: application/json

{"email": "autor2@unifan.com", "senha": "12345678"}

###
@tokenAutor2 = {{loginAutor2.response.body.access_token}}

### 25. Autor 2 tenta editar avaliação de outro autor (esperado 403)
PUT {{baseUrl}}/avaliacoes/{{avaliacaoId}}
Authorization: Bearer {{tokenAutor2}}
Content-Type: application/json

{"valor": 5}

### 26. Autor 2 tenta remover avaliação de outro autor (esperado 403)
DELETE {{baseUrl}}/avaliacoes/{{avaliacaoId}}
Authorization: Bearer {{tokenAutor2}}

### 27. Autor cria uma avaliação extra, só para remover (esperado 201)
# @name criarExtra
POST {{baseUrl}}/avaliacoes
Authorization: Bearer {{tokenAutor}}
Content-Type: application/json

{
  "curso_id": 1,
  "disciplina_id": 1,
  "semestre": "2026.2",
  "data_avaliacao": "2026-12-15",
  "tipo": "FINAL",
  "valor": 10,
  "quantidade_questoes_multipla": 2,
  "quantidade_questoes_abertas": 0
}

###
@extraId = {{criarExtra.response.body.id}}

### 28. Autor remove a avaliação extra (esperado 204)
DELETE {{baseUrl}}/avaliacoes/{{extraId}}
Authorization: Bearer {{tokenAutor}}